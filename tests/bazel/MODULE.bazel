# Test-only application root. Production images consume the dbsyncd
# module directly; they do not acquire a dependency back on sonic-buildimage.
module(name = "sonic_dbsyncd_tests")

bazel_dep(name = "sonic-dbsyncd", version = "2.0.0", repo_name = "sonic_dbsyncd")
local_path_override(
    module_name = "sonic-dbsyncd",
    path = "../..",
)

bazel_dep(name = "sonic-buildimage", version = "0.0.0", repo_name = "sonic_buildimage")
git_override(
    module_name = "sonic-buildimage",
    commit = "c743d7521e80fc1733e5cc0ffc24889b08f78444",
    remote = "https://github.com/securely1g/sonic-buildimage.git",
)

# The pinned image requests SWSS at 0.0.0 and its overrides are not inherited.
single_version_override(
    module_name = "sonic-swss",
    version = "0.0.3-9c3797990d4b5a79100a40fe7689927c18212361",
)

single_version_override(
    module_name = "rules_go",
    version = "0.65.0.sonic.2",
)

single_version_override(
    module_name = "libnl3",
    version = "3.7.0.sonic.10",
)

single_version_override(
    module_name = "re2",
    version = "2024-07-02.bcr.1",
)

single_version_override(
    module_name = "sonic-build-infra",
    version = "0.0.44-35726399908a3beb947174e9359f902077928289",
)

single_version_override(
    module_name = "sonic-rust-deps",
    version = "0.0.5-5bf69bc0a7d9ea9f4a5606264be592867cd29d1e",
)

bazel_dep(name = "rules_distroless", version = "0.9.4.sonic.26")
bazel_dep(name = "rules_python", version = "1.9.0.sonic.2")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "patchelf", version = "0.18.0.bcr.1")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "sonic-build-infra", version = "0.0.44-35726399908a3beb947174e9359f902077928289", repo_name = "sonic_build_infra")
bazel_dep(name = "sonic-swss-common", version = "0.0.9-334389eae54afd1f4f5ee69f89c3a7ad2062ee61", repo_name = "sonic_swss_common")

# The test image and the shared toolchains must use the same APT package graph.
apt = use_extension("@rules_distroless//apt:extensions.bzl", "apt")
apt.import_lock(lock = "@sonic_build_infra//apt:apt.lock.json")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.13",
)
python.toolchain(python_version = "3.11")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "dbsyncd_tests_pip",
    python_version = "3.13",
    requirements_lock = "@sonic_buildimage//src/sonic-config-engine:requirements_lock.txt",
)
use_repo(pip, "dbsyncd_tests_pip")

# The image's Rust extension requires a root tag even for Python-only tests.
# No Rust target participates in this test application.
bazel_dep(name = "rules_rs", version = "0.1.0")

rust = use_extension("@rules_rs//rs:rules_rust_reexported_extensions.bzl", "rust")
rust.toolchain(versions = [])
